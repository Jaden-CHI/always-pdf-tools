ALWAYSPDF_ALLOWED_ORIGINS=*
ALWAYSPDF_MAX_UPLOAD_MB=50
ALWAYSPDF_CONVERSION_TIMEOUT_SECONDS=120
ALWAYSPDF_SOFFICE_PATH=soffice
ALWAYSPDF_GS_PATH=gs
ALWAYSPDF_OCRMYPDF_PATH=ocrmypdf

# Optional. When both values are set, PDF <-> Office conversions use Adobe PDF Services first.
ALWAYSPDF_ADOBE_PDF_SERVICES_ENABLED=true
ALWAYSPDF_ADOBE_PDF_SERVICES_CLIENT_ID=
ALWAYSPDF_ADOBE_PDF_SERVICES_CLIENT_SECRET=
